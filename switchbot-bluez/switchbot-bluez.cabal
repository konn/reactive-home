cabal-version: 3.4
name: switchbot-bluez
version: 0.1.0.0
description: Please see the README on GitHub at <https://github.com/konn/reactive-home/switchbot-bluez#readme>
homepage: https://github.com/konn/reactive-home#readme
bug-reports: https://github.com/konn/reactive-home/issues
author: Hiromi ISHII
maintainer: konn.jinro_at_gmail.com
copyright: (c) Hiromi ISHII 2026- present
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with:
  ghc ==9.12.4

extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/konn/reactive-home
  subdir: switchbot-bluez

common defaults
  autogen-modules: Paths_switchbot_bluez
  other-modules: Paths_switchbot_bluez
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

  default-language: GHC2021
  default-extensions:
    BlockArguments
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    PatternSynonyms
    RecordWildCards
    ScopedTypeVariables
    TypeApplications

  build-depends: base >=4.7 && <5

library
  import: defaults
  hs-source-dirs: src
  -- cabal-gild: discover src --exclude=src/**/Internal.hs --exclude=src/**/Internal/**/*.hs
  exposed-modules:
    Network.SwitchBot.Bluez
    Network.SwitchBot.Bluez.Advertisement

  -- cabal-gild: discover src --include=src/**/Internal.hs --include=src/**/Internal/**/*.hs
  other-modules:
  build-depends:
    bytestring,
    containers,
    dbus,
    safe-exceptions,
    stm,
    switchbot-core,
    text,

executable switchbot-scan-bluez
  import: defaults
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    aeson,
    bytestring,
    switchbot-bluez,

test-suite switchbot-bluez-test
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Test.hs
  -- cabal-gild: discover test --exclude=test/Test.hs
  other-modules: Network.SwitchBot.BluezTest
  build-tool-depends: tasty-discover:tasty-discover
  ghc-options: -threaded
  build-depends:
    bytestring,
    containers,
    dbus,
    process,
    stm,
    switchbot-bluez,
    switchbot-core,
    tasty,
    tasty-hunit,
