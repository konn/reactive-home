cabal-version: 3.4
name: haskesame-core
version: 0.1.0.0
description: Please see the README on GitHub at <https://github.com/konn/reactive-home/haskesame-core#readme>
homepage: https://github.com/konn/reactive-home#readme
bug-reports: https://github.com/konn/reactive-home/issues
author: Hiromi ISHII
maintainer: konn.jinro_at_gmail.com
copyright: (c) Hiromi ISHII 2026- present
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with:
  ghc ==9.12.4

extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/konn/reactive-home
  subdir: haskesame-core

common defaults
  autogen-modules: Paths_haskesame_core
  other-modules: Paths_haskesame_core
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

  default-language: GHC2021
  default-extensions:
    BlockArguments
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    PatternSynonyms
    RecordWildCards
    ScopedTypeVariables
    TypeApplications

  build-depends: base >=4.7 && <5

library
  import: defaults
  hs-source-dirs: src
  -- cabal-gild: discover src --exclude=src/**/Internal.hs --exclude=src/**/Internal/**/*.hs
  exposed-modules:
    Network.Sesame
    Network.Sesame.Client
    Network.Sesame.Codec
    Network.Sesame.Crypto
    Network.Sesame.Exception
    Network.Sesame.Transport
    Network.Sesame.Types

  -- cabal-gild: discover src --include=src/**/Internal.hs --include=src/**/Internal/**/*.hs
  other-modules:
  build-depends:
    async,
    bytestring,
    crypton,
    list-t,
    memory,
    safe-exceptions,
    stm,
    stm-containers,
    text,
    uuid,

test-suite haskesame-core-test
  import: defaults
  type: exitcode-stdio-1.0
  main-is: Test.hs
  hs-source-dirs: test
  -- cabal-gild: discover test --exclude=test/Test.hs
  other-modules:
  ghc-options:
    -threaded
    -O2
    -rtsopts
    -with-rtsopts=-N
