cabal-version: 3.4
name: hasquitto-effectful
version: 0.1.0.0
description: Please see the README on GitHub at <https://github.com/konn/reactive-home/hasquitto-effectful#readme>
homepage: https://github.com/konn/reactive-home#readme
bug-reports: https://github.com/konn/reactive-home/issues
author: Hiromi ISHII
maintainer: konn.jinro_at_gmail.com
copyright: (c) Hiromi ISHII 2026- present
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with:
  ghc ==9.12.4

extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/konn/reactive-home
  subdir: hasquitto-effectful

common defaults
  autogen-modules: Paths_hasquitto_effectful
  other-modules: Paths_hasquitto_effectful
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

  default-language: GHC2021
  default-extensions:
    BlockArguments
    DataKinds
    DerivingStrategies
    DuplicateRecordFields
    GADTs
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    PatternSynonyms
    RecordWildCards
    TypeFamilies

  build-depends: base >=4.7 && <5

library
  import: defaults
  hs-source-dirs: src
  -- cabal-gild: discover src --exclude=src/**/Internal.hs --exclude=src/**/Internal/**/*.hs
  exposed-modules: Effectful.Network.Mqtt
  -- cabal-gild: discover src --include=src/**/Internal.hs --include=src/**/Internal/**/*.hs
  other-modules:
  build-depends:
    bytestring,
    effectful,
    hasquitto-auto-reconnect,
    hasquitto-core,

test-suite hasquitto-effectful-test
  import: defaults
  type: exitcode-stdio-1.0
  main-is: Test.hs
  hs-source-dirs: test
  -- cabal-gild: discover test --exclude=test/Test.hs
  other-modules:
  ghc-options:
    -threaded
    -O2
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    effectful,
    hasquitto-effectful,
    tasty,
    tasty-hunit,

test-suite hasquitto-effectful-integration
  import: defaults
  type: exitcode-stdio-1.0
  main-is: Integration.hs
  hs-source-dirs: test-integration
  -- cabal-gild: discover test-integration --exclude=test-integration/Integration.hs
  other-modules:
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    bytestring,
    effectful,
    hasquitto-core,
    hasquitto-effectful,
    stm,
    tasty,
    tasty-hunit,
    text,
    time,
